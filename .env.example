# Leave LLM_PROVIDER blank to auto-detect whichever key you set below,
# or explicitly set: nvidia | gemini | groq | openrouter | openai | anthropic | ollama | demo
LLM_PROVIDER=

# --- Free / Developer Tiers ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Standard Paid Providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Optional Mozaik Cloud Telemetry ---
MOZAIK_API_KEY=

# --- Runtime Controls ---
PORT=3000
MAX_CONCURRENT_LLM_CALLS=3
AUTO_APPROVE_BREAKPOINTS=false

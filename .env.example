# CorridorAudit Environment Configuration
# Copy to `.env` for local or production use (never commit `.env`).
# Leaving LLM_PROVIDER blank auto-detects the first configured API key below.

# Explicit provider override:
# nvidia | gemini | groq | openrouter | openai | anthropic | ollama
LLM_PROVIDER=
# Optional universal overrides for the selected provider above:
LLM_API_KEY=
LLM_MODEL=

# --- Free / Developer Tiers ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Standard Paid Providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Optional Mozaik Cloud Telemetry ---
MOZAIK_API_KEY=

# --- Server & Runtime Controls ---
HOST=127.0.0.1
PORT=3000
NO_OPEN=0
HOT_FOLDER=./data/inbox
MAX_CONCURRENT_LLM_CALLS=3
PROVIDER_FULL_RECONCILIATION_INTERVAL_HOURS=168
AUTO_APPROVE_BREAKPOINTS=false
# Production requires a private ClamAV clamd endpoint. Do not expose its TCP port publicly.
CORRIDOR_CLAMD_HOST=
CORRIDOR_CLAMD_PORT=3310

# --- Authentication ---
# Keep local development open. Production requires Cognito and fails closed without it.
CORRIDOR_AUTH_MODE=local
NEXT_PUBLIC_CORRIDOR_AUTH_MODE=local
CORRIDOR_SESSION_SECRET=
CORRIDOR_BOOTSTRAP_OWNER_EMAIL=
CORRIDOR_PUBLIC_BASE_URL=http://localhost:3000
# Exact comma-separated hostnames allowed for generic JSON connectors in production.
CORRIDOR_PROVIDER_ENDPOINT_HOSTS=
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_CALLBACK_URL=http://localhost:3000/api/auth/callback
